# 308 Digital - Environment Variables for GoDaddy Production Deployment
# INSTRUCTIONS:
# 1. Copy this file to .env on the GoDaddy server
# 2. Replace all placeholder values with your actual values
# 3. Keep .env secret - never commit to git
# 4. Set file permissions: chmod 600 .env

# Django Settings
DJANGO_SETTINGS_MODULE=digital_site.settings_production
DJANGO_SECRET_KEY=your-secure-random-key-here-min-50-chars
DEBUG=False

# Database Configuration (from GoDaddy cPanel)
DB_ENGINE=django.db.backends.mysql
DB_NAME=e1zcw712avko_308digital_db
DB_USER=e1zcw712avko_308digital_user
DB_PASSWORD=your-database-password-here
DB_HOST=localhost
DB_PORT=3306

# Allowed Hosts (your domain)
ALLOWED_HOSTS=28h.524.mytemp.website,www.28h.524.mytemp.website

# Security (set to True after SSL is installed)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Email Configuration (Optional - for contact form notifications)
# Uncomment and configure to enable email notifications
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-specific-password
